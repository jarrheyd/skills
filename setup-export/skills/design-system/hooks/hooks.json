{
  "description": "Design system enforcement — validates UI files against DESIGN-SYSTEM.md tokens and patterns",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/design_system_hook.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
